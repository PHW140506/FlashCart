cat << 'EOF' > .gitignore
# .NET
bin/
obj/
*.user
*.suo
.vs/
*.db
*.db-shm
*.db-wal

# Angular & Node
node_modules/
dist/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs y SO
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
EOF
